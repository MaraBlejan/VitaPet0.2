@model VitaPet0._2.Models.Owner

@{
    ViewData["Title"] = "Add Owner";
}

<section class="section py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-success text-white py-3">
                        <h4 class="mb-0 text-center"><i class="bi bi-person-plus me-2"></i>Add New Owner</h4>
                    </div>
                    <div class="card-body p-4">
                        <form asp-controller="Owners" asp-action="Create" method="post" id="ownerForm">
                            @Html.AntiForgeryToken()

                            <!-- Aici vor apărea erorile generale dacă există -->
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="FirstName" class="form-label fw-bold">First Name</label>
                                    <input asp-for="FirstName" class="form-control" placeholder="John" required />
                                    <span asp-validation-for="FirstName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="LastName" class="form-label fw-bold">Last Name</label>
                                    <input asp-for="LastName" class="form-control" placeholder="Doe" required />
                                    <span asp-validation-for="LastName" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Phone" class="form-label fw-bold">Phone</label>
                                    <input asp-for="Phone" class="form-control" placeholder="0720 123 456" required />
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="john@example.com" required />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Address" class="form-label fw-bold">Address</label>
                                <input asp-for="Address" class="form-control" placeholder="Street, Number, City..." required />
                                <span asp-validation-for="Address" class="text-danger"></span>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">Save Owner</button>
                                <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}