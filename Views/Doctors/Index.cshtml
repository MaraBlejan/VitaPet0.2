@model IEnumerable<VitaPet0._2.Models.Doctor>

@{
    ViewData["Title"] = "Team List";
}

<section class="section py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="text-success fw-bold"><i class="bi bi-person-badge me-2"></i>Medici / Echipă</h1>
            <a asp-action="Create" class="btn btn-success">
                <i class="bi bi-person-plus me-2"></i>Adaugă Medic
            </a>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Nume</th>
                                <th>Specialization</th>
                                <th>Email</th>
                                <th>Created</th>
                                <th class="text-center pe-4">Acțiuni</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.FirstName @item.LastName</td>
                                    <td>@item.Specialization</td>
                                    <td>@item.Email</td>
                                    <td>@item.CreatedAt.ToString("dd MMM yyyy")</td>
                                    <td class="text-center pe-4">
                                        <div class="btn-group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Info</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Șterge</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
